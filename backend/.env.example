# Google Drive Configuration
# Use oauth para uma pasta do Meu Drive (consome a cota da conta autorizada).
# Use service_account somente ao enviar para uma Unidade Compartilhada.
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_FILE=oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=oauth-token.json
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_DRIVE_FOLDER_ID=YOUR_FOLDER_ID_HERE

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://bonnano.github.io
